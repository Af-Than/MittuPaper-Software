# ---- Server ----
PORT=5050
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/paper_delivery_manager
# Change this to a long random string in any real deployment
JWT_SECRET=change-me-to-a-long-random-string
# Origin of the React app (used for CORS)
CLIENT_ORIGIN=http://localhost:5173

# ---- The two admin accounts (created ONLY by `npm run seed`) ----
ADMIN1_USERNAME=admin1
ADMIN1_NAME=Agency Owner
ADMIN1_PASSWORD=Admin@123
ADMIN2_USERNAME=admin2
ADMIN2_NAME=Agency Manager
ADMIN2_PASSWORD=Admin@456
